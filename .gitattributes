# Normalize line endings so shell and PowerShell scripts keep working regardless of the OS the
# repo is checked out on. Shell scripts must stay LF (a CRLF shebang breaks them); PowerShell is
# happiest with CRLF on Windows.
* text=auto

*.sh       text eol=lf
*.command  text eol=lf
*.bash     text eol=lf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.pdf      binary
