{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anthill",
  "version": "0.7.5",
  "identifier": "org.onehill.anthill",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Anthill",
        "width": 1200,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/anthill-server"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../scripts/entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OneHillAI/Anthill/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzM0M0REM1NTMyQkE3ODUKUldTRnB5dFR4VTA4UTdkYmlDL253Nm5oVFlMUXVGTTIrLzBQaFREb2hHQ0dPRTZYRkc2cVZrR3gK"
    }
  }
}
