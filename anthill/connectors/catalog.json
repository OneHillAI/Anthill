  {
    "id": "discord",
    "name": "Discord",
    "category": "communication",
    "summary": "Read and post messages in your Discord server.",
    "tier": "community",
    "upstream": "io.github.pasympa/discord-mcp",
    "transport": "stdio",
    "command": "npx -y @pasympa/discord-mcp@2.0.0",
    "auth": {
      "type": "token",
      "fields": [
        {"key": "bot_token", "label": "Discord bot token", "placeholder": "your bot token", "required": true, "target": "env", "env": "DISCORD_TOKEN"}
      ]
    },
    "scopes": ["read channels", "read messages", "post a message"],
    "provides_files": false,
    "guided": false,
    "setup_url": "https://www.npmjs.com/package/@pasympa/discord-mcp",
    "note": "Community MCP server (not an official Anthropic/Discord package), pinned to a reviewed version (@2.0.0) so a later release cannot silently change what runs with your bot token - review its scopes before use. Create a Discord application and bot, invite it with only the permissions you need, then paste its token. Anthill stores it encrypted and runs the connector with it."
  },
