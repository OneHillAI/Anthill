[
  {
    "id": "filesystem",
    "name": "Filesystem",
    "category": "documents",
    "summary": "Read and search files in a folder you grant.",
    "tier": "verified",
    "upstream": "io.modelcontextprotocol/filesystem",
    "transport": "stdio",
    "command": "npx -y @modelcontextprotocol/server-filesystem {path}",
    "auth": {
      "type": "none",
      "fields": [
        {"key": "path", "label": "Folder to share", "placeholder": "/Users/you/Documents", "required": true, "target": "command"}
      ]
    },
    "scopes": ["read files", "list a directory", "search file contents"],
    "provides_files": true,
    "guided": true,
    "setup_url": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem"
  },
