{
  "id": "/",
  "name": "Anthill",
  "short_name": "Anthill",
  "description": "Anthill by Onehill Foundation - your organization's private, local AI: chat, wiki, and agents that stay inside your perimeter.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FAF5ED",
  "theme_color": "#1A110A",
  "categories": ["productivity", "business"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New chat", "short_name": "Chat", "url": "/chat", "description": "Start a new chat" },
    { "name": "Wiki", "short_name": "Wiki", "url": "/wiki", "description": "Open the organization wiki" },
    { "name": "Tasks", "short_name": "Tasks", "url": "/tasks", "description": "View tasks" }
  ]
}
